 app=(BASE/'app.js').read_text().replace('Katharine',name).replace('katharine',slug)
 app=app.replace("student:'"+name+"',cards:{}","student:'"+name+"',appId:D.appId,drafts:{},cards:{}")
 app=app.replace('newLimit:5,sessionLimit:20,maxChapter:5','newLimit:D.defaults.newLimit,sessionLimit:D.defaults.sessionLimit,focusOnly:D.defaults.focusOnly,maxChapter:5')
 app=app.replace('function eligibleWord(w){return (','function eligibleWord(w){return (!state.settings.focusOnly||w.focus)&&(')
 app=app.replace("for(const key of ['typed','autoAudio','extensions'])","for(const key of ['typed','autoAudio','extensions','focusOnly'])")
 app=app.replace('function validate(x){','function validate(x){if(x&&((x.appId&&x.appId!==D.appId)||x.student!==D.student))throw Error("This backup belongs to a different learner.");')
 app=app.replace('const v=initial();v.createdAt=',"const v=initial();for(const [k,t] of Object.entries(x.drafts||{}))if(D.workshops.some(w=>w.id===k)&&typeof t==='string')v.drafts[k]=t.slice(0,10000);v.createdAt=")
 app=app.replace('All 308 entries, including words added from the questions.',str(len(full['words']))+' entries. Start with your focus pack; use the rest as reference.')
 app=app.replace(' / 694.', ' / ${D.audioExpected}.')
 app=app.replace("'Coverage is incomplete; device fallback is labelled when used.'","'Some generated audio is not available. No device voice is silently substituted.'")
 start=app.index("if(!('speechSynthesis'in window))",app.index('async function playAudio'))
 end=app.index('\nasync function loadAudio',start)
 app=app[:start]+"toast('Generated pronunciation is unavailable. Check your connection or download the offline audio first.');}"+app[end:]
 focus_panel="""`<section class="panel tint"><div class="eyebrow">YOUR FOCUS PACK</div><h2>${esc(D.focusTitle)}</h2><p class="muted">${D.words.filter(w=>w.focus).length} focus words. The full glossary is optional, not extra homework.</p><button class="btn small" data-action="toggleFocus">${state.settings.focusOnly?'Show all words in review instead':'Review only my focus pack'}</button></section>`+"""
 app=app.replace("$('#main').innerHTML=heading('Your daily rhythm'","$('#main').innerHTML="+focus_panel+"heading('Your daily rhythm'")
 app=app.replace("case 'start':start();break;","case 'toggleFocus':state.settings.focusOnly=!state.settings.focusOnly;save();render();break;case 'saveDraft':{const id=b.dataset.workshop;state.drafts[id]=$('#draft-'+id).value.slice(0,10000);save();toast('Draft saved on this device.');break;}case 'start':start();break;")
 workshop="""function renderWorkshops(){return (D.workshops||[]).map(w=>`<section class="panel"><h2>${esc(w.title)}</h2><p>${esc(w.prompt)}</p>${w.steps.map((s,i)=>`<p>${i+1}. ${esc(s)}</p>`).join('')}<label for="draft-${w.id}">My draft (saved only on this device)</label><textarea id="draft-${w.id}" rows="9" style="width:100%;font:inherit;line-height:1.8;padding:12px" maxlength="10000">${esc(state.drafts[w.id]||'')}</textarea><button class="btn primary" data-action="saveDraft" data-workshop="${w.id}">Save my draft</button><p class="muted">No automatic score and no automatic submission. Export a backup before switching devices.</p></section>`).join('');}\n"""
 app=app.replace('function renderPatterns(){',workshop+'function renderPatterns(){')
 app=app.replace("heading('Sentence patterns','Small pieces. Real sentences.','Choose one pattern. Read its examples, then change one detail and say your own sentence.')+D.patterns", "heading('Sentence patterns','Small pieces. Real sentences.','Choose one pattern. Read its examples, then change one detail and say your own sentence.')+renderWorkshops()+D.patterns")
 app=app.replace("function renderSettings(){const s=state.settings;$('#main').innerHTML=", "function renderSettings(){const s=state.settings;$('#main').innerHTML=`<section class=\"panel\"><label><input type=\"checkbox\" data-setting=\"focusOnly\" ${s.focusOnly?'checked':''}> Review my focus pack only</label><p>Other words stay in the searchable glossary.</p></section>`+")
 (A/'app.js').write_text(app)
 html=(BASE/'index.html').read_text().replace('Katharine',name).replace('<span class="avatar">K</span>','<span class="avatar">'+name[0]+'</span>')
 if slug!='katharine':html=html.replace('Chapters 001–005','Your focus pack')
 (A/'index.html').write_text(html)
 for f in ['styles.css','scheduler.js','icon.svg']:shutil.copyfile(BASE/f,A/f)
 sw=(BASE/'sw.js').read_text().replace('katharine',slug)
 sw=sw.replace("const u=new URL(e.request.url);if", "const u=new URL(e.request.url);const shared=new URL('../shared/',ROOT);if")
 sw=sw.replace('!u.pathname.startsWith(ROOT.pathname)',"!(u.pathname.startsWith(ROOT.pathname)||u.pathname.startsWith(shared.pathname))")
 (A/'sw.js').write_text(sw)
 dump(A/'manifest.webmanifest',dict(name=name+' · Fly Korean',short_name=name+' Korean',start_url='./',scope='./',display='standalone',background_color='#f7f5ef',theme_color='#23594e',icons=[dict(src='icon.svg',sizes='any',type='image/svg+xml',purpose='any')]))
 (A/'README.md').write_text('# '+name+' Korean practice\n\n'+full['focusTitle']+'\n\nIndependent local progress and backups. New course material is teacher-authored practice guided by reviewed topics, not a claim that every word was already taught. Audio coverage is validated in audio-manifest.json. No private transcript, calendar event, student-platform ID or personal contact details are published.\n\nOpen index.html after extracting the full package; retain ../shared/audio. For microphone and installed offline app features use the HTTPS URL.\n')
 summaries.append(dict(slug=slug,name=name,focus=full['focusTitle'],focusWords=sum(w['focus'] for w in full['words']),referenceWords=len(full['words']),patterns=len(full['patterns']),dailyPDFs=len(full['sheets']),audioExpected=full['audioExpected'],url='https://g4jy.github.io/korean-practice-hub/students/'+slug+'/'))
# The delivery index is not published in the student website.
dump(ROOT/'rollout-summary.json',summaries)
dump(SH/'vocabulary.json',words)
print(json.dumps(dict(apps=len(summaries),glossary=len(words),newAudio=len(requests),appSummary=summaries),ensure_ascii=False))
