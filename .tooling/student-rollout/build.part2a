for learner in learners:
 slug=learner['slug'];name=learner['name'];A=OUT/slug;A.mkdir(exist_ok=True)
 focus=[term for key in learner['modules'] for term in C.MODULES[key]['focus']]
 focus=list(dict.fromkeys(focus));full=deepcopy(original) if slug=='katharine' else dict(version=1,student=name,words=[],questions=[],patterns=[],grammar=deepcopy(original['grammar']),sheets=[])
 if slug!='katharine':
  full['words']=deepcopy(sorted(words,key=lambda w:(0 if w['ko'] in focus else 1,focus.index(w['ko']) if w['ko'] in focus else words.index(w))))
  for w in full['words']:w['focus']=w['ko'] in focus
  ids=list(dict.fromkeys(p for key in learner['modules'] for p in C.MODULES[key]['patterns']));full['patterns']=[deepcopy(allpatterns[p]) for p in ids]
  for key in learner['modules']:
   m=C.MODULES[key]
   for mode,items in [('conversation',m['questions']),('translation',[t['en'] for t in m['translation']])]:
    for i in range(0,len(items),6):
     chunk=items[i:i+6];sid=key+'-'+mode+'-'+str(i//6+1);url='pdfs/practice/'+sid+'.pdf';title=m['title']+' / '+('Speak' if mode=='conversation' else 'English to Korean')+' '+str(i//6+1)
     page_pdf(A/url,name,title,chunk,mode)
     full['sheets'].append(dict(id=sid,title=title,url=url,ch=1,extension=False,kind=mode,questions=chunk))
   reference(A/('pdfs/answers/'+key+'.pdf'),name,m['title']+' / Model sentences',[para('Several translations may be correct. Read the English prompt before opening this reference.')]+[table([['English','One natural Korean answer']]+[[t['en'],t['ko']] for t in m['translation']],[261,262])])
   full['questions'] += [dict(id=key+'-'+str(i+1),ko=q,original=q,ch=1,extension=False,kind='conversation') for i,q in enumerate(m['questions'])]
  full['workshops']=[dict(id=key,**C.MODULES[key]['workshop']) for key in learner['modules'] if C.MODULES[key]['workshop']]
  ref=A/'pdfs/05_Reference'
