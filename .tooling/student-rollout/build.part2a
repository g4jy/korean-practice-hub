  lastx=59+pdfmetrics.stringWidth(lines[-1],'KR',14);ly=y-6-(len(lines)-1)*21
  c.setDash(1,3);c.line(min(lastx+8,416),ly-2,440,ly-2);c.setDash();c.line(445,ly-6,W-36,ly-6);c.line(445,ly-27,W-36,ly-27)
  y-=rowheight
 c.setFont('KR',8);c.drawString(36,43,'Pass 1: read and speak.   Pass 2: fold the notes away and speak again.');c.drawRightString(W-36,43,'1 / 1');c.save();pdf_summary.append(str(path.relative_to(OUT)))
def reference(path,name,title,story):
 path.parent.mkdir(parents=True,exist_ok=True)
 def foot(c,d):c.setFont('KR',8);c.drawString(36,24,'Fly Korean / '+name);c.drawRightString(A4[0]-36,24,str(d.page))
 SimpleDocTemplate(str(path),pagesize=A4,rightMargin=36,leftMargin=36,topMargin=36,bottomMargin=42,title=name+' - '+title,author='Fly Korean').build([para(title,'h1')]+story,onFirstPage=foot,onLaterPages=foot)
def table(data,widths):
 t=Table([[para(v,'small') for v in row] for row in data],colWidths=widths,repeatRows=1,hAlign='LEFT');t.setStyle(TableStyle([('VALIGN',(0,0),(-1,-1),'TOP'),('LINEBELOW',(0,0),(-1,0),.6,(.2,.2,.2)),('LINEBELOW',(0,1),(-1,-1),.2,(.85,.85,.85)),('TOPPADDING',(0,0),(-1,-1),5),('BOTTOMPADDING',(0,0),(-1,-1),5)]));return t
