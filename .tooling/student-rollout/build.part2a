  for w in full['words']:groups[w['pos']].append(w)
  story=[para('Start with the focus pack in the app. The rest is a reference glossary, not an additional assignment.')]
  for pos,ws in groups.items():
   story+=[para(pos,'h2'),table([['Korean / polite form','Meaning']]+[[w['ko']+(' / '+w['yo'] if w['yo'] else ''),w['en']] for w in ws],[225,298])]
  reference(ref/'Vocabulary_by_POS.pdf',name,'Vocabulary by word type',story)
  reference(ref/'Verb_Adjective_Forms.pdf',name,'Dictionary and polite forms',[table([['Dictionary','Polite','Meaning']]+[[w['ko'],w['yo'],w['en']] for w in full['words'] if w['yo']],[140,150,233])])
  story=[]
  for p in full['patterns']:story += [para(p['id']+' / '+p['title'],'h2'),para(p['form']),para(p['en'])]+[para(e['ko']+'\n'+e['en']) for e in p['examples']]
  reference(ref/'Sentence_Patterns_and_Grammar.pdf',name,'Sentence patterns',story)
  reference(ref/'Teacher_Guide_and_Audit.pdf',name,'Guide',[para('Give one small worksheet a day. Default card reviews use the selected focus pack; the larger word library is optional.'),para('These are newly authored practice items guided by reviewed learning topics. They are not a complete transcript-derived curriculum or evidence of mastery.'),para('Use fictitious names, addresses and circumstances. Do not ask a learner to publish private life or contact details.'),para('Two recall directions have independent local review histories. A recognition success does not automatically mark Korean production mastered.'),para('The scheduler is SM-2-inspired, not FSRS. Back up before changing device, browser or website address. No teacher inbox or automatic grading service is connected.'),para('Pronunciation is pre-generated Korean neural MP3. A fallback voice is not silently substituted. Report questionable pronunciation to the teacher.'),para('Writing prompts are original workshops, not official TOPIK exam papers. No automated essay score is provided.')])
 else:
  shutil.copytree(BASE/'pdfs',A/'pdfs',dirs_exist_ok=True)
  for w in full['words']:w['focus']=True
  full['workshops']=[]
 full.update(appId='fly-korean-'+slug+'-v1',student=name,focusTitle='Chapters 001–005' if not learner['modules'] else ' + '.join(C.MODULES[k]['title'] for k in learner['modules']),defaults=dict(newLimit=learner.get('newLimit',5),sessionLimit=learner.get('sessionLimit',20),focusOnly=slug!='katharine'))
 full['audioExpected']=sum(2+bool(w['yo']) for w in full['words'])
 dump(A/'data.json',full);(A/'data.js').write_text('window.KATHARINE_DATA='+json.dumps(full,ensure_ascii=False)+';')
