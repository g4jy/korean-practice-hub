"""Original practice content; no private lesson transcript or student identifiers."""
import json, hashlib
from pathlib import Path
EXTRA=[]
def rows(group,text):
 for ln in text.strip().splitlines():
  if not ln.strip():continue
  ko,yo,en,ex,tr=ln.split('|')
  pos='Verb' if yo!='-' else 'Noun'
  EXTRA.append(dict(id='x'+hashlib.sha256(ko.encode()).hexdigest()[:10],ko=ko,yo='' if yo=='-' else yo,en=en,example=ex,exampleEn=tr,pos=pos,group=group,ch=0,source='Teacher-authored practice extension',aliases=[],note=''))
